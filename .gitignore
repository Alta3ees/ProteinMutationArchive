# ============================================================
# Generated scientific data
# ============================================================

# Mutation scan outputs
data/results/mutation_scans/

# Legacy human-guided session outputs
data/results/human_guided_sessions/

# Persistent local design projects
#
# These may contain:
# - generated structures
# - design_archive.json
# - PROJECT_CONTEXT.md
# - experimental evidence
# - NMR/SPR/SEC/CD data
# - literature files
# - notes
# - session outputs
data/projects/

# Temporary archive-development output
data/results/test_design_archive.json

# ============================================================
# Scientific / experimental files that should not be
# accidentally committed
# ============================================================

*.csv
*.tsv
*.xlsx
*.xls
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.ucsf

# Images generated/imported as evidence
*.png
*.jpg
*.jpeg
*.tif
*.tiff

# Keep directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/results/mutation_scans/.gitkeep

# Scientific structure and result files should enter archives through the UI
*.pdb
*.pdb.gz
*.silent
*.silent.gz
*.sc
*.fasc
*.tr
*.log

# Temporary files
tmp/
temp/
*.tmp

# =========================
# Secrets / local config
# =========================
.env
.env.*
!.env.example

# =========================
# Local experiment files
# =========================
local/
scratch/
